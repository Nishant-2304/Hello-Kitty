# Google Sheet the bot reads/writes.
# Find the ID in the Google Sheet URL: /spreadsheets/d/<THIS_PART>/edit
# The service account in service_account.json must be shared as Editor on this sheet.
SPREADSHEET_ID=YOUR_GOOGLE_SHEET_ID

# Per-user Google OAuth (added in PR 2 — frontend signs in, backend stores
# the user's refresh token for Gmail drafts).
# GOOGLE_OAUTH_CLIENT_ID=YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET
# SESSION_SECRET=generate-a-random-32-char-string-for-cookie-signing
